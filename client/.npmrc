# `engines` is a floor, not a suggestion. npm only WARNS on a mismatch by
# default, which is how a runtime two majors below the one this project builds,
# tests and ships gets installed without anybody being told. With this set an
# `npm ci` or `npm install` on an older Node refuses and names the version it
# wanted — the same floor the Containerfile stages build on, the installers
# install, and server/index.js checks at boot.
engine-strict=true
