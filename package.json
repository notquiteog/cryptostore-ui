{
  "name": "cryptostore-ui-workspace",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.12.1" },
  "scripts": {
    "setup": "npm ci --prefix client",
    "dev": "cd client && npm run dev -- --config ../ui/vite.config.mjs",
    "build": "npm run build --prefix client",
    "preview": "cd client && npm run preview -- --config ../ui/vite.config.mjs",
    "test": "cd client && node --test test/*.test.mjs"
  }
}
